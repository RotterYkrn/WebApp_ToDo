POSTGRES_USER=developer
POSTGRES_PASSWORD=password
POSTGRES_DB=todo_database
TZ=Asia/Tokyo

# initdb 実行時に渡す追加オプション（公式 postgres Docker イメージで有効）
# 日本語ロケールと UTF-8 エンコーディングでクラスタを初期化するための設定です。
# 注意: このロケールがイメージ内に存在する必要があります（例: ja_JP.UTF-8 をインストール済み）。
POSTGRES_INITDB_ARGS="--encoding=UTF8 --lc-collate=ja_JP.UTF-8 --lc-ctype=ja_JP.UTF-8"
